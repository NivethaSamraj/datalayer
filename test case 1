test(
  'TC001 - Verify the Datalayer Validation for E2E script Registered User',
  async ({ page }: { page: Page }, testInfo: TestInfo, report = {}) => {

    test.info().annotations.push(
      { type: 'Author', description: 'Dinesh' },
      { type: 'TestCase', description: 'Verify the Datalayer Validation for E2E script Registered User' },
      { type: 'Test Description', description: 'Verify the Datalayer Validation for E2E script Registered User' }
    );

    const commonSteps = new CommonStepImpl(page, report);
    const dataLayer = new DataLayerStepImpl(page, testInfo, commonSteps);

    const lambdaLink: string = await commonSteps.getLambdaTestLink(page);

    const testData = await DataLayerDataEngine.create('TC002');
    const searchKeyword = testData.searchKeyword;
    try {

      await test.step('Validate DataLayer variables on Home Page', async () => {
        await dataLayer.validateCheckpoint(
          PageName.HomePage,
          [ValidationGroup.ALL_PAGES]
        );
      });

      await test.step('Login from Header', async () => {
        await commonSteps.signInAsRegisteredUser(testData.email, testData.password);
      });

      await test.step('Navigate to Search Result page and validate DataLayer variables', async () => {
        await commonSteps.navigateToSearchresultsPage('shirt');
        await dataLayer.validateCheckpoint(
          PageName.ProductListingPage,
          [ValidationGroup.ALL_PAGES, ValidationGroup.SEARCH_GALLERY],
          { searchKeyword }
        );
      });

      await test.step('Navigate to PDP and validate DataLayer variables', async () => {
        await commonSteps.navigateToRandomProduct();
        await dataLayer.validateCheckpoint(
          PageName.PDPPage,
          [ValidationGroup.ALL_PAGES, ValidationGroup.PDP], { searchKeyword }
        );
      });

      await test.step('Add product to cart, navigate to Cart and validate DataLayer variables', async () => {
        await commonSteps.addToCartAndNavigateToCartPage();
        await dataLayer.validateCheckpoint(
          PageName.CartPage,
          [ValidationGroup.ALL_PAGES, ValidationGroup.CART_PAGE, ValidationGroup.ALL_PAGES_WITH_CART_ITEM], { searchKeyword }
        );
      });

      await test.step('Proceed to checkout as Registered User and validate DataLayer variables', async () => {
        await commonSteps.proceedToCheckout();
        await commonSteps.enterPhoneNumber(testData);
        await commonSteps.clickContinueButtonOnCheckout();

        // Use the manual Credit Card path (same as guest flow):
        // clicks #is-CREDIT_CARD, fills card details, fills #secCode CVV.
        // The "Talbots credit card" saved-card option has no CVN field,
        // so enterSecurityCodeForRegisteredUser() is intentionally removed.
        await commonSteps.enterCreditcarddetails();
        await commonSteps.clickContinueButtonOnBillingCheckout();

        await dataLayer.validateCheckpoint(
          PageName.CheckoutPage,
          [ValidationGroup.ALL_PAGES, ValidationGroup.CHECKOUT_ADDRESS_VERIFICATION], { searchKeyword }
        );
      });

      await test.step('Proceed to Placing the Order and validate DataLayer variables', async () => {
        await commonSteps.placeorder();
        await dataLayer.validateCheckpoint(
          PageName.OrderConfirmationPage,
          [ValidationGroup.ALL_PAGES, ValidationGroup.ORDER_CONFIRM], { searchKeyword }
        );
      });

    } catch (error) {
      throw error;
    } finally {
      await testInfo.attach('lambaLink', {
        body: JSON.stringify(lambdaLink),
        contentType: 'application/json',
      });

      await testInfo.attach(testInfo.title, {
        body: JSON.stringify(report),
        contentType: 'application/json',
      });
      await dataLayer.attachConsolidatedReport();
    }
  }
);
