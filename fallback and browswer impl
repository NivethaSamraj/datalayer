import { Page, Locator, expect, test } from '@playwright/test';
import { BrowserAction } from './BrowserAction';
import { buildSmartLocatorBundle, captureFullPageScreenshot, getElementContextDOM, getElementOuterHTML, getMinimalFullDOM } from '../utils/selfHealing';
import { captureElementScreenshot } from '../utils/selfHealing';
import { getElement, saveElement } from '../core/db/elementRepo';
import { allure } from 'allure-playwright';
import { findWithFallback } from '../core/healing/fallbackEngine';

/**
 * Concrete implementation of the `BrowserAction` interface using Playwright.
 *
 * This class centralizes common browser interactions (click, type, select,
 * screenshotting and fallback-based element resolution) and instruments
 * element captures into the healing database when new elements are seen.
 */
export default class BrowserActionImpl implements BrowserAction {

  private locatorMap = new WeakMap<Locator, string>();

  protected generateElementNamesForSelfHealing(pageObject: any) {

    const pageName = pageObject.constructor.name;

    for (const key of Object.keys(pageObject)) {

      const value = pageObject[key];

      if (
        value &&
        typeof value === 'object' &&
        typeof value.fill === 'function'
      ) {

        this.locatorMap.set(
          value,
          `${pageName}_${key}`
        );
      }
    }
  }


  /**
   * Get a registered, human-friendly element name for a locator when available.
   *
   * @param locator - Playwright `Locator` instance
   * @returns string - Registered element name or 'Unknown_Element'
   */
  protected getElementName(locator: Locator): string {

    return (
      this.locatorMap.get(locator) ??
      'Unknown_Element'
    );
  }

  async click(
    locator: Locator,
    waitForPageRefresh: boolean = false
  ): Promise<void> {

    const page = locator.page();

    const elementName =
      this.getElementName(locator);

    let finalLocator = locator;
    let usedFallback = false;

    try {

      await locator.waitFor({
        state: 'visible',
        timeout: 5000
      });

      await locator.click();

    } catch {

      const result = await findWithFallback(
        page,
        elementName,
        locator
      );

      finalLocator = result.locator;
      usedFallback = true;

      await finalLocator.click();
    }

    if (!usedFallback) {
      await test.step('Capture & Persist Element', async () => {
        const exists = await this.elementExistsInDB(elementName);

        if (!exists) {
          await this.captureAndStore(finalLocator, elementName, finalLocator.toString());

          // Attach the generated smart locators to Allure for visibility
          try {
            const bundle = await buildSmartLocatorBundle(finalLocator, elementName);
            allure.attachment('Captured Smart Locators', JSON.stringify(bundle.smartLocators, null, 2), 'application/json');
          } catch (err) {
            // non-fatal
          }
        }
      });
    }

    if (waitForPageRefresh) {

      await this.waitForPageRefresh(
        page,
        elementName
      );

      await page.waitForLoadState(
        'load'
      );
    }
  }

