    /**
    * Gets the coupon discount amount for each product in the cart.
    *
    * Discount = Original Price - Final Price
    *
    * @returns Promise<string[]>
    */
    async getCartProductsCouponDiscount(): Promise<string[]> {
        const cartPage = new CartPage(this.page);
 
        const originalPrices = await cartPage.getCartProductsOriginalPrice();
        const finalPrices = await cartPage.getCartProductsFinalPrice();
 
        const toNumber = (value?: string): number => {
            const match = value?.match(/[\d,.]+/);
            return match ? parseFloat(match[0].replace(/,/g, '')) : 0;
        };
 
        return finalPrices.map((finalPrice, index) => {
            const original = toNumber(originalPrices[index]);
            const final = toNumber(finalPrice);
 
            return (original - final).toFixed(2);
        });
    }
 
