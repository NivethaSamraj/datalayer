async payWithPayPal(): Promise<void> {
    const email = process.env.PAYPAL_USER;
    const password = process.env.PAYPAL_PASS;
    if (!email || !password) {
        throw new Error('PayPal credentials missing. Set PAYPAL_USER and PAYPAL_PASS in .env');
    }
    const checkoutPage = new CheckoutPage(this.page);
    await checkoutPage.selectPayPalAndPay(email, password);
}

