async clickContinueBilling(): Promise<this> {
    const btn = this.locators.btnContinueBilling(this.page);
    const placeOrder = this.locators.lblPlaceOrder(this.page);

    for (let attempt = 0; attempt < 3; attempt++) {
        await btn.waitFor({ state: 'visible', timeout: 30000 });
        await this.scrollIntoView(btn);

        // Small settle so the billing submit handler is attached before clicking.
        await this.page.waitForTimeout(1000);
        await btn.click({ force: true });

        try {
            await placeOrder.waitFor({ state: 'visible', timeout: 15000 });
            return this; // advanced to Place Order step
        } catch {
            if (attempt === 2) {
                throw new Error(
                    'Billing did not advance to Place Order after 3 Continue clicks.'
                );
            }
            // else loop and click again
        }
    }
    return this;
}
