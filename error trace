async clickCreditCard(): Promise<this> {
    // 1. list all frames
    console.log('=== FRAMES ===');
    this.page.frames().forEach(f => console.log('FRAME:', f.name(), '|', f.url()));

    // 2. list all radios in the MAIN frame
    console.log('=== RADIOS (main) ===');
    const radios = this.page.getByRole('radio');
    const n = await radios.count();
    console.log('radio count:', n);
    for (let i = 0; i < n; i++) {
        console.log(i,
            'label=', JSON.stringify(await radios.nth(i).getAttribute('aria-label')),
            'value=', JSON.stringify(await radios.nth(i).getAttribute('value')),
            'visible=', await radios.nth(i).isVisible().catch(() => 'err'));
    }

    // 3. dump any payment-looking text
    console.log('=== PAYMENT LABELS ===');
    const labels = this.page.locator('label, [role="radio"]');
    const ln = await labels.count();
    for (let i = 0; i < Math.min(ln, 40); i++) {
        const t = (await labels.nth(i).textContent().catch(() => ''))?.trim();
        if (t && /credit|card|payment|paypal|gift/i.test(t)) console.log('LABEL:', JSON.stringify(t));
    }

    throw new Error('DIAGNOSTIC STOP - read the console output above');
}
