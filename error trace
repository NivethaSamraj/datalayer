async enterPhoneNumber(value: string): Promise<this> {
    const phoneNumberField = this.locators.inpPhoneNumber(this.page);

    // Registered users may have phone pre-filled; field may not always render.
    if (await phoneNumberField.count() > 0 &&
        await phoneNumberField.first().isVisible().catch(() => false)) {
        await this.type(phoneNumberField, value);
        console.log('Entered phone (registered):', await phoneNumberField.inputValue());
    } else {
        console.log('Phone field not present — skipping (likely pre-filled).');
    }
    return this;
}
