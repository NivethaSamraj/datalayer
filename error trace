async enterSecurityCodeForRegisteredUser(securityCode: string): Promise<this> {
    const cvn = this.locators.inptCardSecurityNumberRegUser(this.page);
    await cvn.waitFor({ state: 'visible', timeout: 30000 });
    await cvn.click();
    await cvn.pressSequentially(securityCode, { delay: 50 });
    return this;
}
