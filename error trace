import { checkoutBasePage } from "../../base/checkoutPageLocators";
import { BrandLocatorOverride } from "../../registry/locatorTypes";
import { Page } from '@playwright/test';

/**
 * Brand-specific locator configuration for Checkout Page.
 *
 * Purpose:
 * - Override locator values defined in base/checkoutPage.ts.
 * - Add brand-specific locators that do not exist in the base page.
 *
 * Supported Usage:
 *
 * Override existing locator:
 *   userName: '#usernameInput'
 *
 * Add new brand-specific locator:
 *   loyaltyCard: '#loyaltyCard'
 *
 * IntelliSense:
 * - Existing base locator keys will be suggested automatically.
 * - New brand-specific locator keys can also be added when required.
 *
 * Notes:
 * - Use the exact base locator key name when overriding.
 * - Incorrect key names will not override the base locator.
 * - Brand-specific locators should be added only when they are not common across brands.
 */
export const talbotsCheckoutPage: BrandLocatorOverride<typeof checkoutBasePage> = {

    txtFirstName: (page: Page) => page.getByRole('textbox', { name: 'First Name' }),

     lblCheckout:
        (page: Page) =>
            page.getByText(
                'Guest Checkout',
                { exact: true }
            )

};
