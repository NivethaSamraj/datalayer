import { Page, Locator, expect } from '@playwright/test';
import BrowserActionImpl from '../utils/BrowserActionsImpl';
import { LocatorRegistry } from '../locators/registry/LocatorRegistry';
import { pageNameConstants } from '../constants/pageNameConstants';
import { LocatorFactory } from '../locators/registry/locatorTypes';
import { checkoutBasePage } from '../locators/base/checkoutPageLocators';
import { talbotsCheckoutPage } from '../locators/override/Talbots/checkoutPageLocators';
import { ann_taylorCheckoutPage } from '../locators/override/Ann_Taylor/checkoutPageLocators';

export const checkoutPageLocators = {

    ...checkoutBasePage,

    ...talbotsCheckoutPage,

    ...ann_taylorCheckoutPage
};

/**
 * Page Object Model for Checkout Page.
 */
export class CheckoutPage extends BrowserActionImpl {
    readonly page: Page;

    private readonly locators:
        typeof checkoutPageLocators;

    constructor(page: Page) {
        super();

        this.page = page;

        this.locators =
            LocatorRegistry.getLocators(
                pageNameConstants.CHECKOUTPAGE
            ) as typeof checkoutPageLocators;

        this.generateElementNamesForSelfHealing(this);
    }

    async checkoutAsGuest(): Promise<void> {

        await this.locators
            .checkoutAsGuestButton(this.page)
            .click();
    }

    /**
     * Click Checkout As Guest label/button.
     */
    async clickCheckoutAsGuest(): Promise<this> {

        await this.locators
            .checkoutAsGuestButton(this.page)
            .click();

        return this;
    }


    async enterShippingAddressDetails(
        firstName: string,
        lastName: string,
        email: string,
        address1: string,
        zipCode: string,
        city: string,
        state: string,
        phoneNumber: string,
        address2?: string
    ): Promise<this> {
        await this.type(
            this.locators.inpFirstName(this.page),
            firstName
        );

        await this.type(
            this.locators.inpLastName(this.page),
            lastName
        );

        await this.type(
            this.locators.inpEmailForOrderConfirmation(this.page),
            email
        );

        await this.type(
            this.locators.inpAddress1(this.page),
            address1
        );

        if (address2) {

            await this.type(
                this.locators.inpAddress2Optional(this.page),
                address2
            );
        }

        await this.type(
            this.locators.inpZIPCode(this.page),
            zipCode
        );

        await this.type(
            this.locators.inpCity(this.page),
            city
        );
        await this.selectDropdownByValue(
            this.locators.drpState(this.page),
            state
        );

        console.log(
            'Selected state:',
            await this.locators.drpState(this.page).inputValue()
        );

        // Phone field renders late on some runs; ensure it's present before typing.
        const phoneField = this.locators.inpPhoneNumber(this.page);
        await phoneField.waitFor({ state: 'visible', timeout: 30000 });
        await this.type(phoneField, phoneNumber);

        // Verify the phone actually populated (empty phone silently blocks Continue).
        const enteredPhone = await phoneField.inputValue();
        console.log('Entered phone:', enteredPhone);

        return this;
    }

    async enterCreditCardDetails(
        nameOnCard: string,
        cardNumber: string,
        expirationMonth: string,
        expirationYear: string,
        securityCode: string
    ): Promise<this> {

        const name = this.locators.inpNameOnCard(this.page);
        await name.waitFor({ state: 'visible', timeout: 30000 });
        await name.click();
        await name.pressSequentially(nameOnCard, { delay: 50 });

        const num = this.locators.inpCardNumber(this.page);
        await num.click();
        await num.pressSequentially(cardNumber, { delay: 50 });
        await num.blur();

        await this.selectDropdownByValue(
            this.locators.drpCardExpirationMonth(this.page),
            expirationMonth
        );
        await this.selectDropdownByValue(
            this.locators.drpCardExpirationYear(this.page),
            expirationYear
        );

        const cvv = this.locators.inpCardSecurityNumber(this.page);
        await cvv.click();
        await cvv.pressSequentially(securityCode, { delay: 50 });
        await cvv.blur();

        // Verify the card number actually committed. The Aurus payment field can
        // remount after the shipping step settles and silently wipe earlier input,
        // which later surfaces as a 30s hang at the Place Order wait.
        const committed = (await num.inputValue().catch(() => '')).replace(/\s/g, '');
        if (!committed || committed.length < 12) {
            throw new Error(
                `Card number did not commit (got "${committed}"). ` +
                'The payment field likely remounted after shipping — ' +
                're-enter card details after the payment area is stable, ' +
                'or the field is inside an iframe and needs a frameLocator.'
            );
        }

        return this;
    }

    async enterPhoneNumber(value: string): Promise<this> {

        const phoneNumberField =
            this.locators.inpPhoneNumber(this.page);
        await phoneNumberField.waitFor({ state: 'visible', timeout: 30000 });
        await this.type(
            phoneNumberField,

            value
        );

        const enteredPhone = await phoneNumberField.inputValue();
        console.log('Entered phone (registered):', enteredPhone);

        return this;
    }

    async clickContinueShipping(): Promise<this> {
        const btn = this.locators.btnContinueShipping(this.page);

        await btn.waitFor({ state: 'visible', timeout: 30000 });
        await btn.scrollIntoViewIfNeeded();
        await btn.click();

        // Race the success target (payment section opening) against a visible
        // validation error. This makes a rejected shipping form fail in ~2s with
        // the actual reason instead of burning the full 30s on a hung waitFor.
        const paymentArea = this.page
            .locator('#payment-methods-area, form#dwfrm_billing, #is-CREDIT_CARD')
            .first();

        const shippingError = this.page
            .locator(
                '.shipping-error .alert-danger, ' +
                '#dwfrm_shipping .invalid-feedback:visible, ' +
                '.error-message:visible'
            )
            .first();

        const outcome = await Promise.race([
            paymentArea
                .waitFor({ state: 'visible', timeout: 30000 })
                .then(() => 'payment' as const),
            shippingError
                .waitFor({ state: 'visible', timeout: 30000 })
                .then(() => 'error' as const),
        ]).catch(() => 'timeout' as const);

        if (outcome === 'error') {
            const msg = (await shippingError.textContent().catch(() => ''))?.trim();
            throw new Error(
                `Shipping step rejected — billing section did not open. Validation: "${msg}"`
            );
        }

        if (outcome === 'timeout') {
            throw new Error(
                'Shipping Continue clicked but the payment section never appeared ' +
                '(no visible validation error either). Likely the shipping-method ' +
                'AJAX did not settle, or the Continue submit was a no-op.'
            );
        }

        return this;
    }

    async clickPlaceOrder(): Promise<this> {

        await this.locators.lblPlaceOrder(this.page).click();

        return this;
    }

    async clickCreditCard(): Promise<this> {
        await this.locators.radCreditCard(this.page).click({ force: true });

        return this;
    }

    async enterSecurityCodeForRegisteredUser(
        securityCode: string
    ): Promise<this> {

        const cvn =
            this.locators.inptCardSecurityNumberRegUser(this.page);

        await cvn.waitFor({
            state: 'visible',
            timeout: 30000
        });

        await cvn.click();

        await cvn.pressSequentially(
            securityCode,
            { delay: 50 }
        );

        return this;
    }

    async clickContinueBilling(): Promise<this> {
        const continueBilling = this.locators.btnContinueBilling(this.page);

        await continueBilling.waitFor({ state: 'visible', timeout: 30000 });
        await this.scrollIntoView(continueBilling);

        // Commit any focused payment field by clicking a neutral spot, instead of
        // a blind keyboard Tab to an unknown element. The previous Tab + force-click
        // fired the submit regardless of form validity, producing a 30s hang when
        // billing did not actually advance.
        await this.page
            .locator('body')
            .click({ position: { x: 0, y: 0 } })
            .catch(() => { /* non-fatal: only used to blur the active field */ });

        await continueBilling.click();

        // Race the Place Order step against a visible billing validation error so a
        // rejected/declined payment fails fast with its reason rather than timing out.
        const placeOrder = this.locators.lblPlaceOrder(this.page);

        const billingError = this.page
            .locator(
                '#dwfrm_billing .invalid-feedback:visible, ' +
                '.alert-danger:visible, ' +
                '.error-message:visible'
            )
            .first();

        const outcome = await Promise.race([
            placeOrder
                .waitFor({ state: 'visible', timeout: 30000 })
                .then(() => 'placeorder' as const),
            billingError
                .waitFor({ state: 'visible', timeout: 30000 })
                .then(() => 'error' as const),
        ]).catch(() => 'timeout' as const);

        if (outcome === 'error') {
            const msg = (await billingError.textContent().catch(() => ''))?.trim();
            throw new Error(
                `Billing step rejected — Place Order never appeared. Validation: "${msg}"`
            );
        }

        if (outcome === 'timeout') {
            throw new Error(
                'Billing Continue clicked but Place Order never appeared. ' +
                'Check whether the Aurus payment iframe accepted the card ' +
                '(test card 4111 1111 1111 1111 may be declined on this environment).'
            );
        }

        return this;
    }
}
